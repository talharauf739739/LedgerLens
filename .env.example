# Copy to .env for local development:  cp .env.example .env
# Nothing in this file is a real secret. Real secrets never go in git.

ENV=local

# --- LLM ---------------------------------------------------------------------
# foundry_local | ollama | azure_foundry
LLM_PROVIDER=foundry_local
# Model alias (Foundry Local / Ollama) or deployment name (Azure). Check the catalog: `foundry model list`
LLM_MODEL=phi-4-mini
# Leave empty to let the SDK start Foundry Local and discover its port.
# Containers can't host Foundry Local: set this to the host's endpoint, e.g. http://host.docker.internal:<port>
FOUNDRY_LOCAL_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com/

# --- Azure-compatible storage: Floci-az locally ------------------------------
# devstoreaccount1 and its key are the public, well-known emulator credentials (same as Azurite).
# Endpoint paths verified against floci-az 0.17.0 (blob: /devstoreaccount1, queue: /devstoreaccount1-queue).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:4577/devstoreaccount1;QueueEndpoint=http://localhost:4577/devstoreaccount1-queue;
# Cloud: set this instead and authenticate with managed identity
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
BLOB_CONTAINER=documents
JOBS_QUEUE=extraction-jobs
# KEY_VAULT_URL=http://localhost:4577/devstoreaccount1-keyvault

# --- Open-source services ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ledgerlens:ledgerlens@localhost:5432/ledgerlens
CACHE_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=ledgerlens

# --- Review UI -----------------------------------------------------------------
# 1 enables PDF uploads in the Streamlit app (needs an LLM). Never set it on the public demo.
LEDGERLENS_ALLOW_UPLOAD=0

# --- API -----------------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_PAGES=50
CORS_ORIGINS=["http://localhost:8501"]
